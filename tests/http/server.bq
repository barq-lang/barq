// Started by tests/test_barq.py: barq run server.bq <port> <requests>
list<string> argv = args()
int port = ~int(argv[0])
int max = ~int(argv[1])

Http.serve(karo(Request req): any
    if (req.path == "/")
        return "<h1>Barq</h1>"
    if (req.path == "/hello")
        return Response.json(#{"hello": req.query("name", "world"), "method": req.method})
    if (req.path == "/echo")
        return #{"all": req.all(), "agent": req.header("x-test"), "json": req.isJson()}
    if (req.path == "/users" and req.method == "POST")
        Validator v = Validation.make(req.all(), #{"name": "required|min:2", "email": "required|email"})
        if (v.fails())
            return Response.json(#{"errors": v.errors()}, 422)
        return Response.json(req.only(#["name", "email"]), 201)
    if (req.path == "/old")
        return Response.redirect("/hello")
    if (req.path == "/boom")
        raise new Exception("handler failed")
    return Response.text("Not found: " + req.path, 404)
, #{"port": port, "max": max, "static": "public", "quiet": true})
print("server done")
