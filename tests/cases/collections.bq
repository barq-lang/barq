list<int> nums = #[4, 1, 3]
nums.push(2, 5)
print(nums, nums.len(), nums.sum(), nums.first(), nums.last())
print(nums.copy().sort(), nums.indexOf(3), nums.contains(9))
print(nums.reduce(kr(int acc, int x): int => acc + x, 0))
print(nums.filter(kr(int x): bool => x > 2).map(kr(int x): string => "n{x}").join(", "))
nums[0] = 40
print(nums.slice(0, 2), nums.pop(), nums)

dict<string, int> ages = #{"ali": 30, "sara": 25}
ages["omar"] = 41
print(ages.keys(), ages.values(), ages.has("ali"), ages.get("zed", 0), ages.len())
ages.remove("ali")
print(ages)

set<int> s = #(1, 2, 2, 3)
s.add(4)
print(s, s.has(2), s.union(#(9)), s.intersect(#(2, 3, 7)), s.len())
print(~list(range(3)), ~set(#["a", "a", "b"]), "a,b,c".split(","), Str.join(#["x", "y"], "-"))

list<list<int>> matrix = #[#[1, 2], #[3, 4]]
print(matrix[1][0], matrix)
