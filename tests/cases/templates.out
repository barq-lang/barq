200 text/html; charset=utf-8
<!DOCTYPE html>
<html>
<head>
    <title>Users · Demo</title>
    <style>
        body { font-family: sans-serif; }
    </style>
</head>
<body>
    <nav>
    <a href="/" class="first">Home</a>
    <a href="/users">Users</a>
</nav>
    <main>
    <h1>Users (2)</h1>
    <ul>
        <li class="odd">1/2 <strong>Ali</strong> — ali@example.com (admin)</li>
        <li class="even">2/2 <strong>Sara &lt;script&gt;</strong> — sara@example.com</li>
    </ul>
    <p>2 shown, static text</p>
    <div class="card"><h3>Tip</h3><p>&lt;b&gt;bold&lt;/b&gt; is escaped</p></div>
    <div class="card"><h3>Empty</h3><p>no body</p></div>

    </main>
    <footer>default footer</footer>
    <script>
        const data = {"ok":true,"msg":"\u003c/script\u003e\u003cb\u003e"};
        if (data.ok) { console.log("ready"); }
    </script>
</body>
</html>
