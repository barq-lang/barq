print(s.upper(), s.lower(), s.len(), s.contains("Barq"), s.startsWith("He"), s.endsWith("q"))
print(s.replace("Barq", "World"), s.substr(7), s.substr(0, 5), s.indexOf("B"), s[0], s[-1])
